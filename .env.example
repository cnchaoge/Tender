# Copy to .env and edit. Do not commit .env, data/.secret_key,
# or data/initial_admin_password.txt.

# Local/dev (default): if SECRET_KEY is unset, the first startup writes a
# stable random JWT secret to data/.secret_key and reuses it.
# Production (DEBUG=false or APP_ENV=production) refuses to start until
# SECRET_KEY is a unique value. The old public default is rejected everywhere.
DEBUG=true
APP_ENV=development
# SECRET_KEY=

# Loopback by default. Official start (start.sh / run.bat) binds this address
# with one uvicorn process. Do not add --reload or --workers: Chroma and
# SQLite must not be opened by two processes. Do not set 0.0.0.0 to expose
# plain HTTP on an office network. An HTTPS reverse proxy is out of scope.
HOST=127.0.0.1
PORT=8000

# ollama | dashscope | openai | minimax | deepseek | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ollama | dashscope | bge | m3e | mock
# EMBED_PROVIDER=ollama

# COMPANY_NAME=投标单位名称
# MAX_FILE_SIZE=50

# Comma-separated directories the knowledge-base folder scan may copy from.
# Empty disables folder scan. A home directory, a parent of home, or a
# filesystem root is ignored. Upload still copies into data/library/.
# KB_SCAN_ROOTS=/absolute/path/to/bid-files
